OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
LLM_MODEL=gpt-4o
CLAUDE_MODEL=claude-3-5-sonnet-20241022
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048

HF_MODEL_SENTIMENT=distilbert-base-uncased-finetuned-sst-2-english
HF_MODEL_NER=dslim/bert-base-NER
HF_MODEL_SUMMARISE=facebook/bart-large-cnn
HF_MODEL_ZERO_SHOT=facebook/bart-large-mnli
SLM_MAX_LENGTH=512
SLM_DEVICE=cpu

FAISS_INDEX_PATH=data/faiss_index
EMBED_MODEL=text-embedding-3-small
RAG_TOP_K=5

MAX_WORKFLOW_STEPS=20
EXECUTION_TIMEOUT_SECS=300
MAX_PARALLEL_TASKS=5

GENAI_MAX_TOKENS=4096
GENAI_TEMPERATURE=0.7

DATA_DIR=data
OUTPUT_DIR=outputs
DB_URL=sqlite:///nexusai.db

APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
